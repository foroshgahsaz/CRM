APP_NAME="سامانه درخواست‌ها"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Tehran

APP_LOCALE=fa
APP_FALLBACK_LOCALE=fa
APP_FAKER_LOCALE=fa_IR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite

# تولید / Kubernetes — DB_CONNECTION=mysql و یکی از روش‌ها:
# 1) DB_* را مستقیم پر کنید
# DB_HOST=mysql
# DB_PORT=3306
# DB_DATABASE=crm
# DB_USERNAME=crm
# DB_PASSWORD=
#
# 2) یا MYSQL_* را در Deployment تزریق کنید (اگر DB_HOST هنوز 127.0.0.1 است، از 1.1.1 MYSQL_HOST خوانده می‌شود)
# MYSQL_HOST=
# MYSQL_PORT=3306
# MYSQL_DATABASE=
# MYSQL_USER=
# MYSQL_PASSWORD=
#
# قبل از migrate: php artisan crm:check-env

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# log: فقط خارج از production پیام را در حافظه ثبت می‌کند و در production موفق فرض نمی‌شود.
# sms_ir: ارسال گروهی REST در sms.ir (پیشنهادی برای production ایران).
# http: POST سفارشی با Authorization: Bearer و بدنه to، message، sender.
SMS_GATEWAY=log
SMS_LOG_CODES=false
SMSIR_API_KEY=
SMSIR_LINE_NUMBER=
SMS_HTTP_URL=
SMS_HTTP_TOKEN=
SMS_SENDER=
SMS_HTTP_TIMEOUT=10
